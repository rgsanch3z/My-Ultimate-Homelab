cat <<EOF > ~/My-Ultimate-Homelab/.gitignore
# --- Docker & Stacks ---
.env
**/data/
**/prometheus_data/
**/grafana_data/

# --- Pi-hole Specific ---
stacks/general/pihole/config/*
stacks/general/pihole/dnsmasq.d/*
!**/config/.gitkeep
!**/dnsmasq.d/.gitkeep

# --- Ansible ---
*.retry
ansible.log
.ansible_check

# --- OS & Logs ---
.DS_Store
Thumbs.db
*.log
EOF